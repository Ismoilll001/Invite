{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invite",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khushbakht-db",
      "database_id": "ef43a683-af7a-416b-b0d8-2e751a5c814d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "khushbakht-files"
    }
  ]
}
